{
  "manifest_version": 3,
  "name": "Opera Morning Call",
  "version": "1.0.0",
  "description": "Seu checklist de pré-abertura.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "activeTab"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": [
    "https://brapi.dev/*",
    "https://api.marketaux.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
