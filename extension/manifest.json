{
  "manifest_version": 3,
  "name": "Opera Morning Call",
  "version": "1.0.1",
  "description": "Seu checklist de pr\u00e9-abertura.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.operatrader.com.br/*",
    "https://opera-proxy.datamapleai.workers.dev/*"
  ],
  "content_security_policy": {
    "extension_pages": "frame-src https://www.tradingview-widget.com https://s.tradingview.com; script-src 'self'; object-src 'self'; connect-src 'self' https://api.operatrader.com.br https://opera-proxy.datamapleai.workers.dev"
  },
  "homepage_url": "https://www.operatrader.com.br",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
